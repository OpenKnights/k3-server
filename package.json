{
  "name": "k3-server",
  "type": "module",
  "version": "2.0.0",
  "description": "A lightweight, TypeScript-first HTTP server factory powered by unjs/h3.",
  "author": "king-3 <w2196592083@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/OpenKnights/k3-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenKnights/k3-server.git"
  },
  "bugs": {
    "url": "https://github.com/OpenKnights/k3-server/issues"
  },
  "keywords": [
    "http",
    "server",
    "http-server",
    "local-server",
    "test-server",
    "h3"
  ],
  "imports": {
    "#/*": "./",
    "#types/*": "./types/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "play": "tsx playground/server.ts",
    "build": "tsdown",
    "test": "vitest",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "dependencies": {
    "h3": "2.0.1-rc.26",
    "srvx": "^0.12.4"
  },
  "devDependencies": {
    "@king-3/eslint-config": "^6.1.0",
    "@king-3/prettier-config": "^3.4.0",
    "@prettier/plugin-oxc": "^0.2.2",
    "@types/node": "^26.1.2",
    "bumpp": "^12.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
